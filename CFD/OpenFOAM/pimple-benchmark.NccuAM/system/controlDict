FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

startTime       0;
stopAt          endTime;
endTime 0.001;

deltaT          5e-5;

writeFormat     binary;
writePrecision  6;

maxCo           1.5;
maxDeltaT       0.001;
adjustTimeStep  yes;

writeControl    adjustableRunTime;
writeInterval 0.001;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

functions
{
    #include "forces"
}

