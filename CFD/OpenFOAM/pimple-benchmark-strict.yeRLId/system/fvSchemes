FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         cellLimited Gauss linear 0;
    grad(U)         cellLimited Gauss linear 0.333;
    grad(k)         cellLimited Gauss linear 0.333;
    grad(omega)     cellLimited Gauss linear 0.333;
}

divSchemes
{
    default         none;

    div(phi,U)      bounded Gauss linearUpwindV grad(U);
    //div(phi,U)      bounded Gauss upwind;

    // Required by some OF builds when assembling U residual / limited schemes
    div(div(phi,U)) Gauss linear;

    div(phi,k)      bounded Gauss upwind;
    div(phi,omega)  bounded Gauss upwind;
    //div(phi,k)      bounded Gauss linearUpwind grad(k);
    //div(phi,omega)  bounded Gauss linearUpwind grad(omega);

    // Viscous stress term (incompressible)
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited 1.0;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited 1.0;
}

wallDist
{
    method          meshWave;
}

